# 默认配置（ESP32-S3 N16R8，16MB Flash + 8MB Octal PSRAM）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM（8MB Octal）：240x320 帧缓冲（150KB）分配在 PSRAM，避免占用内部 RAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 网络（STA + SoftAP 并存：STA 连外部网络，SoftAP 无密码热点供临时访问配置页）
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# mDNS
CONFIG_MDNS_MAX_SERVICES=4

# 电源管理（屏幕休眠时 CPU 空闲自动降频，配合 main.c 的 esp_pm_configure）
CONFIG_PM_ENABLE=y

# 兼容旧版 I2C 驱动（driver/i2c.h），抑制其弃用告警（告警会触发 -Werror）
CONFIG_I2C_SUPPRESS_DEPRECATE_WARN=y

# 控制台输出走 USB-Serial-JTAG（ESP32-S3 原生 USB，未接 UART0 桥接）
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
# CONFIG_ESP_CONSOLE_UART is not set
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

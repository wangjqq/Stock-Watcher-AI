# 默认配置（ESP32-S3 N16R8，16MB Flash + 8MB Octal PSRAM）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM（8MB Octal）：240x320 帧缓冲（150KB）分配在 PSRAM，避免占用内部 RAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 网络（纯 STA，无 AP 配网：设备端「系统 → WiFi」页手动连接）
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# mDNS
CONFIG_MDNS_MAX_SERVICES=4

# 电源管理（屏幕休眠时 CPU 空闲自动降频，配合 main.c 的 esp_pm_configure）
CONFIG_PM_ENABLE=y
